{
  "name": "space-opera",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host",
    "build": "tsc -b && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:pages": "cross-env VITE_OFFLINE=1 BASE_PATH=/space-opera/ vite build",
    "build:e2e": "cross-env VITE_OFFLINE=1 vite build",
    "test:e2e": "playwright test",
    "simulate": "tsx scripts/simulate.ts",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@fontsource/exo-2": "^5.2.0",
    "@fontsource/orbitron": "^5.2.0",
    "express": "^5.3.0",
    "motion": "^14.2.0",
    "peerjs": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-zoom-pan-pinch": "^4.2.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.13"
  },
  "description": "Jeu de plateau d'aventure spatiale inspiré des JdR de science-fiction (React, TypeScript, SQLite)"
}
